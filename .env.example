# Server Configuration
PORT=6037

# --- Google AI Studio (default) ---
# API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# --- Vertex AI (Google Cloud Console) ---
# Enable Vertex instead of an API key. Auth uses Application Default Credentials
# (service account JSON via GOOGLE_APPLICATION_CREDENTIALS, or gcloud ADC).
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# Optional AVR-prefixed aliases:
# GEMINI_USE_VERTEXAI=true
# GEMINI_VERTEX_PROJECT=your-gcp-project-id
# GEMINI_VERTEX_LOCATION=us-central1

GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# Instruction Loading Methods (choose one):
# Method 1: Direct environment variable (highest priority)
GEMINI_INSTRUCTIONS="You are a helpful assistant that can answer questions and help with tasks."

# Method 2: Web service (medium priority) - uncomment to use
#GEMINI_URL_INSTRUCTIONS="https://your-api.com/instructions"

# Method 3: Local file (lowest priority) - uncomment to use
#GEMINI_FILE_INSTRUCTIONS="./instructions.txt"

# Optional
GEMINI_THINKING_LEVEL=MINIMAL
GEMINI_THINKING_BUDGET=0